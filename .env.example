# Model backend. Any OpenAI-compatible server: Ollama, llama.cpp, vLLM.
# Ollama defaults to port 11434; llama.cpp server defaults to 8080.
SOC_TRIAGE_MODEL_BASE_URL=http://localhost:11434/v1
SOC_TRIAGE_MODEL=qwen2.5:14b-instruct
SOC_TRIAGE_API_KEY=not-needed
SOC_TRIAGE_MODEL_TIMEOUT=120

# Set to 1 to run the API with a fixture model and no GPU.
SOC_TRIAGE_STUB_MODEL=0
